FROM kalilinux/kali-rolling

USER root

# n8n intentionally runs as root in this disposable Kali security-testing
# container so workflows can install and execute security tools with apt.
# Do NOT expose this container directly to an untrusted network.

# Install base dependencies without upgrading the entire Kali image.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      nano \
      python3 \
      python3-pip \
      build-essential \
    && rm -rf /var/lib/apt/lists/*

# Node.js 22 LTS.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# Pin N8N_VERSION at build time for reproducible deployments.
ARG N8N_VERSION=latest
RUN npm install -g n8n@${N8N_VERSION} && npm cache clean --force

# n8n data directory. Compose maps this to the persistent volume.
ENV N8N_USER_FOLDER=/home/node
ENV N8N_PORT=5678

RUN mkdir -p /home/node/.n8n

EXPOSE 5678

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -fsS http://127.0.0.1:5678/healthz || exit 1

CMD ["n8n"]
