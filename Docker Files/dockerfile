FROM kalilinux/kali-rolling

USER root

# n8n intentionally runs as root inside this disposable Kali security-testing
# container so workflows can install and execute security tools with apt.
# The command wrapper adds an execution policy before shell commands run.

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      nano \
      python3 \
      python3-pip \
      build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

ARG N8N_VERSION=latest
RUN npm install -g n8n@${N8N_VERSION} && npm cache clean --force

COPY n8nkali-exec /usr/local/bin/n8nkali-exec
RUN chmod 0755 /usr/local/bin/n8nkali-exec && mkdir -p /home/node/.n8n

ENV N8N_USER_FOLDER=/home/node
ENV N8N_PORT=5678

EXPOSE 5678

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -fsS http://127.0.0.1:5678/healthz || exit 1

CMD ["n8n"]
