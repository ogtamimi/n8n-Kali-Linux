# Pin a specific release for reproducible deployments.
N8N_VERSION=latest

# Local bind configuration
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Replace with a long random value before starting n8n.
# Example: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Required API authentication for the CTF assessment webhook.
# Example: openssl rand -hex 32
CTF_API_KEY=replace-with-a-long-random-api-key

# Required comma-separated exact hostnames/IPs that are valid CTF targets.
# Example: ctf.local,10.10.20.15
CTF_ALLOWED_HOSTS=replace-with-authorized-ctf-hosts

# Global workflow request backstop. The workflow also applies a per-session limit.
CTF_RATE_LIMIT_WINDOW_SECONDS=300
CTF_RATE_LIMIT_MAX_REQUESTS=10
CTF_SESSION_RATE_LIMIT_MAX_REQUESTS=5
