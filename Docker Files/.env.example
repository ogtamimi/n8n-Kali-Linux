# n8n version. Use a specific version for reproducible builds.
N8N_VERSION=latest

# Local bind configuration
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Replace this with a long random value before using n8n.
# Example: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret
