#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: n8nkali-exec <base64-command>" >&2
  exit 2
fi

if ! COMMAND="$(printf '%s' "$1" | base64 -d 2>/dev/null)"; then
  echo "Rejected: invalid base64 command" >&2
  exit 3
fi

if [[ -z "$COMMAND" || ${#COMMAND} -gt 4096 ]]; then
  echo "Rejected: invalid or oversized command" >&2
  exit 3
fi

# Commands run as root inside the disposable Kali container by design.
# Block shell composition, redirection, expansion and command wrappers so the
# approved-tool policy cannot be bypassed through the shell.
if [[ "$COMMAND" == *$'\n'* || "$COMMAND" == *$'\r'* || "$COMMAND" == *';'* || "$COMMAND" == *'&&'* || "$COMMAND" == *'||'* || "$COMMAND" == *'>'* || "$COMMAND" == *'<'* || "$COMMAND" == *'`'* || "$COMMAND" == *'$('* || "$COMMAND" == *'${'* ]]; then
  echo "Rejected: shell control syntax is not allowed" >&2
  exit 4
fi

PROGRAM="${COMMAND%%[[:space:]]*}"

case "$PROGRAM" in
  apt-get|apt-cache|curl|wget|http|httpx|nikto|whatweb|nmap|gobuster|ffuf|feroxbuster|dirsearch|wfuzz|sqlmap|python|python3|git|grep|egrep|fgrep|awk|sed|cut|sort|uniq|head|tail|tr|strings|base64|cat|ls|find|pwd|whoami|id|date|printf|env|file|xxd)
    ;;
  *)
    echo "Rejected: command is not in the approved security-tool policy" >&2
    exit 5
    ;;
esac

case " $COMMAND " in
  *" docker "*|*" docker.io "*|*" nsenter "*|*" unshare "*|*" mount "*|*" umount "*|*" chroot "*|*" systemctl "*|*" service "*|*" shutdown "*|*" reboot "*|*" poweroff "*|*" sudo "*|*" su "*|*" sh -c "*|*" bash -c "*")
    echo "Rejected: privileged escape or host-management command" >&2
    exit 6
    ;;
esac

exec bash -c -- "$COMMAND"
