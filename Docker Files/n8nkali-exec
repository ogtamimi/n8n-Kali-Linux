#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: n8nkali-exec <base64-command>" >&2
  exit 2
fi

if ! COMMAND="$(printf '%s' "$1" | base64 -d 2>/dev/null)"; then
  echo "Rejected: invalid base64 command" >&2
  exit 3
fi

if [[ -z "$COMMAND" || ${#COMMAND} -gt 4096 ]]; then
  echo "Rejected: invalid or oversized command" >&2
  exit 3
fi

# Commands intentionally run as root inside the disposable Kali container.
# This wrapper is a policy boundary: only approved security tools and harmless
# output-processing utilities are callable. Shell composition and utilities that
# can launch arbitrary child processes are rejected.
if [[ "$COMMAND" == *$'\n'* || "$COMMAND" == *$'\r'* || "$COMMAND" == *';'* || "$COMMAND" == *'&&'* || "$COMMAND" == *'||'* || "$COMMAND" == *'>'* || "$COMMAND" == *'<'* || "$COMMAND" == *'`'* || "$COMMAND" == *'$('* || "$COMMAND" == *'${'* ]]; then
  echo "Rejected: shell control syntax is not allowed" >&2
  exit 4
fi

PROGRAM="${COMMAND%%[[:space:]]*}"

case "$PROGRAM" in
  apt-get|apt-cache|curl|wget|http|httpx|nikto|whatweb|nmap|gobuster|ffuf|feroxbuster|dirsearch|wfuzz|sqlmap|grep|egrep|fgrep|cut|sort|uniq|head|tail|tr|strings|base64|cat|ls|pwd|whoami|id|date|printf|env|file|xxd)
    ;;
  *)
    echo "Rejected: command is not in the approved security-tool policy" >&2
    exit 5
    ;;
esac

case " $COMMAND " in
  *" docker "*|*" docker.io "*|*" nsenter "*|*" unshare "*|*" mount "*|*" umount "*|*" chroot "*|*" systemctl "*|*" service "*|*" shutdown "*|*" reboot "*|*" poweroff "*|*" sudo "*|*" su "*|*" bash "*|*" sh "*|*" python "*|*" python3 "*|*" perl "*|*" ruby "*|*" node "*|*" xargs "*|*" find "*" )
    echo "Rejected: shell, interpreter, process-launching or host-management command" >&2
    exit 6
    ;;
esac

exec bash -c -- "$COMMAND"
