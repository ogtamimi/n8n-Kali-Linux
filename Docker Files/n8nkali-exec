#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: n8nkali-exec <base64-command>" >&2
  exit 2
fi

COMMAND="$(printf '%s' "$1" | base64 -d 2>/dev/null || true)"

if [[ -z "$COMMAND" || ${#COMMAND} -gt 4096 ]]; then
  echo "Rejected: invalid or oversized command" >&2
  exit 3
fi

# The command is intentionally executed as root inside the disposable Kali container,
# but shell-control syntax and privilege/host-management utilities are blocked here.
if [[ "$COMMAND" == *$'\n'* || "$COMMAND" == *$'\r'* || "$COMMAND" == *';'* || "$COMMAND" == *'&&'* || "$COMMAND" == *'||'* || "$COMMAND" == *'>'* || "$COMMAND" == *'<'* || "$COMMAND" == *'`'* || "$COMMAND" == *'$(''* || "$COMMAND" == *'${'* ]]; then
  echo "Rejected: shell control syntax is not allowed" >&2
  exit 4
fi

PROGRAM="${COMMAND%%[[:space:]]*}"

case "$PROGRAM" in
  apt-get|apt-cache|curl|wget|http|httpx|nikto|whatweb|nmap|ncat|nc|gobuster|ffuf|feroxbuster|dirsearch|wfuzz|sqlmap|python|python3|git|grep|egrep|fgrep|awk|sed|cut|sort|uniq|head|tail|tr|strings|base64|cat|ls|find|pwd|whoami|id|date|printf|env|file|xxd)
    ;;
  *)
    echo "Rejected: command is not in the approved security-tool policy" >&2
    exit 5
    ;;
esac

# Explicitly reject host/container administration and shell escape helpers.
case " $COMMAND " in
  *" docker "*|*" docker.io "*|*" nsenter "*|*" unshare "*|*" mount "*|*" umount "*"|*" chroot "*|*" systemctl "*|*" service "*|*" shutdown "*|*" reboot "*|*" poweroff "*|*" sudo "*|*" su "*|*" sh -c "*|*" bash -c "*" )
    echo "Rejected: privileged escape/host-management command" >&2
    exit 6
    ;;
esac

exec bash -c -- "$COMMAND"
